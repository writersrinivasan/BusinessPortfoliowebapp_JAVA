{
  "name": "lifestyle-manager",
  "version": "1.0.0",
  "description": "A minimal lifestyle tools web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "NODE_ENV=test mocha --recursive ./test --exit",
    "test:unit": "NODE_ENV=test mocha ./test/unit --exit",
    "test:integration": "NODE_ENV=test mocha ./test/integration --exit",
    "test:e2e": "NODE_ENV=test mocha ./test/e2e --exit",
    "test:coverage": "NODE_ENV=test nyc mocha --recursive ./test --exit",
    "view-logs": "cat logs/app-$(date +%Y-%m-%d).log",
    "test:verbose": "NODE_ENV=test mocha --recursive ./test --reporter spec --exit",
    "test:recipe": "NODE_ENV=test mocha ./test/unit/models/recipe.test.js --reporter spec",
    "test:habit": "NODE_ENV=test mocha ./test/unit/models/habit.test.js --reporter spec",
    "test:blog": "NODE_ENV=test mocha ./test/unit/models/blog.test.js --reporter spec"
  },
  "keywords": [
    "recipe",
    "habit",
    "blog",
    "minimal"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "chai": "^6.0.1",
    "jsdom": "^26.1.0",
    "mocha": "^11.7.2",
    "node-mocks-http": "^1.17.2",
    "nyc": "^17.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4"
  }
}
